#!/bin/sh
# Wait for the real SSC service, rather than delaying every boot by a fixed time.
for attempt in $(seq 1 80); do
  if /usr/bin/timeout 1 /usr/local/bin/qrtr-lookup 2>/dev/null | /usr/bin/awk '$1 == 400 { found=1 } END { exit !found }'; then
    exit 0
  fi
  sleep 0.5
done
echo 'Qualcomm sensor service did not become available within 40 seconds' >&2
exit 1
